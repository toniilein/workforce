{
  "name": "Workforce board",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Workforce board",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": "node server.js",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"]
    }
  }
}
