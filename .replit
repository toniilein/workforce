run = "node server.js"
entrypoint = "server.js"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["node", "server.js"]
# Reserved VM, NOT autoscale: the board is a single process holding state in one
# JSON file with in-process SSE clients. Autoscale would run several instances
# (each with its own copy of the board) and wipe the filesystem on every cold
# start, so the board would silently reset. Keep "vm" unless the store moves to
# an external database.
deploymentTarget = "vm"

[[ports]]
localPort = 3000
externalPort = 80

[env]
PORT = "3000"
