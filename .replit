run = "node gateway.js"
entrypoint = "gateway.js"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["node", "gateway.js"]
# Reserved VM: one always-on instance. The gateway holds no state itself (the
# tasks live in the repo), so autoscale would also work — but VM avoids cold
# starts and keeps the URL responsive.
deploymentTarget = "vm"

[[ports]]
localPort = 3000
externalPort = 80

[env]
PORT = "3000"
