run = "npm install && node server.js"
entrypoint = "server.js"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
# Install the one dependency (postgres) before starting.
build = ["npm", "install"]
run = ["node", "server.js"]
# Reserved VM, NOT autoscale. Even with the board data in Postgres, this server
# holds its live-update (SSE) clients in memory, so it must be a single always-on
# instance. Autoscale would run several copies that can't see each other's
# connections. Keep "vm".
deploymentTarget = "vm"

[[ports]]
localPort = 3000
externalPort = 80

[env]
PORT = "3000"
